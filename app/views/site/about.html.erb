<% content_for :tmp_styles do %>
  <style>
    .main-wrapper {
      display: flex;
      gap: 40px;
      max-width: 1500px;
      width: 95%;
      align-items: center;
      justify-content: center;
    }

    .image-container {
      flex: 1;
      display: flex;
      justify-content: flex-end;
    }

    .image-container img {
      width: **680px**;
      height: auto;
      border-radius: 12px;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.15);
    }

    .text-box {
      flex: 1.2;
      background-color: white;
      padding: 45px 50px;
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
      overflow-y: auto;
    }

    .text-box h1 {
      font-size: 24px;
      color: #E68946;
      margin-bottom: 20px;
    }

    .text-box p {
      font-size: 1.05em;
      line-height: 1.8;
      color: #333;
      text-align: justify;
      margin-bottom: 16px;
    }

    @media (max-width: 1000px) {
      .main-wrapper {
        flex-direction: column;
        gap: 20px;
      }

      .image-container {
        justify-content: center;
      }

      .image-container img {
        width: 100%;
        max-width: 500px;
      }

      .text-box {
        padding: 30px;
      }
    }
  </style>
<% end %>

<% I18n.with_locale @locale do %>

  <div class="main-wrapper">
    <div class="image-container">
      <%= image_tag "airport.png", :alt => "Օդանավակայան" %>
    </div>
    <div class="text-box">
      <h1><%= t ".heading" %></h1>

      <p><%= t ".about_1_html" %></p>
      <p><%= t ".about_2_html" %></p>
      <p><%= t ".about_3_html" %></p>
      <p><%= t ".about_4_html" %></p>
      <p><%= t ".about_5_html" %></p>
    </div>
  </div>

<% end %>