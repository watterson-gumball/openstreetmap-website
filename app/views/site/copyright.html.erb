<% content_for :tmp_styles do %>
  <style>
    .copyright-container {
      background-color: #ffffff;
      padding: 50px 70px;
      border-radius: 16px;
      box-shadow: 0 6px 14px rgba(0, 0, 0, 0.15);
      border: 1px solid #ccc;
      max-width: 950px;
      width: 92%;
      position: relative;
    }

    .logo {
      position: absolute;
      top: 30px;
      right: 30px;
      height: 80px;
    }

    h1 {
      text-align: center;
      color: #E68946; 
      margin-bottom: 30px;
      font-size: 2em;
    }

    p {
      font-size: 1.1em;
      line-height: 1.8;
      margin-bottom: 20px;
      text-align: justify;
      color: #333;
    }

    .footer-note {
      text-align: center;
      margin-top: 40px;
      font-size: 0.95em;
      color: #777;
    }
  </style>
<% end %>

<% I18n.with_locale @locale do %>

  <div class="copyright-container">
    <%= image_tag "logoETK.png", :class => "logo" %>

    <h1><%= t ".heading" %></h1>
    <p><%= t ".copyright_1_html" %></p>
    <p><%= t ".copyright_2_html" %></p>
    <p><%= t ".copyright_3_html" %></p>

    <div class="footer-note">
      © <script>document.write(new Date().getFullYear());</script> «Երկրատարածական տեխնոլոգիաների կենտրոն» ՍՊԸ
    </div>
  </div>

<% end %>
