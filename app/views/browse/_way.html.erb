<% if way.redacted? && !params[:show_redactions] %>
  <div class="browse-section browse-redacted">
    <%= t "browse.redacted.message_html",
          :type => t("browse.redacted.type.way"),
          :version => way.version,
          :redaction_link => link_to(t("browse.redacted.redaction",
                                       :id => way.redaction.id), way.redaction) %>
  </div>
<% else %>
  <%= tag.div :class => ["browse-section", "browse-way", { "text-body-secondary" => way.redacted? }] do %>
    <%= render :partial => "browse/common_details", :object => way %>

    <h4><%= t ".documents" %></h4>

    <details open>
      <summary><%= t ".documents_count", :count => way.documents.count %></summary>

      <div class="documents-inner-container">
        <% ["mortgage", "property", "use", "rent"].each do |doc_type| %>
          <details data-type="<%= doc_type %>">
            <summary><%= t("browse.document.type.#{doc_type}") %></summary>
            <ul class="list-unstyled browse-element-list">
              <% way.documents.select { |doc| doc.document_type == doc_type }.each do |document| %>
                <li>
                  <%= link_to highlight_year(document.title), url_for(document.file), target: "_blank", rel: "noopener" %>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </details>

    <% if way.floor_plans.count > 0 %>

      <h4><%= t ".floor_plans" %></h4>

      <details>
        <summary><%= t ".floor_plans_count", :count => way.floor_plans.count %></summary>

        <div class="documents-inner-container">
          <ul class="list-unstyled browse-element-list">
            <% way.floor_plans.each do |plan| %>
              <li>
                <%= link_to highlight_year(plan.title), url_for(plan.file), target: "_blank", rel: "noopener" %>
              </li>
            <% end %>
          </ul>
        </div>
      </details>
    <% end %>
  <% end %>
<% end %>
