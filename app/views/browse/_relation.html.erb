<% if relation.redacted? && !params[:show_redactions] %>
  <div class="browse-section browse-redacted">
    <%= t "browse.redacted.message_html",
          :type => t("browse.redacted.type.relation"),
          :version => relation.version,
          :redaction_link => link_to(t("browse.redacted.redaction",
                                       :id => relation.redaction.id), relation.redaction) %>
  </div>
<% else %>
  <%= tag.div :class => ["browse-section", "browse-relation", { "text-body-secondary" => relation.redacted? }] do %>
    <%= render :partial => "browse/common_details", :object => relation %>
  <% end %>
  <h4><%= t ".documents" %></h4>
    <details <%= "open" if relation.documents.count < 10 %>>
      <summary><%= t ".documents_count", :count => relation.documents.count %></summary>
      <div class="documents-inner-container">
        <% ["mortage", "property", "use", "rent"].each do |doc_type| %>
          <details data-type="<%= doc_type %>">
            <summary><%= t(".#{doc_type}") %></summary>
            <ul class="list-unstyled browse-element-list">
              <% relation.documents.select { |doc| doc.document_type == doc_type }.each do |document| %>
                <li>
                  <%= link_to highlight_year(document.title), url_for(document.file), target: "_blank", rel: "noopener" %>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
      </div>
    </details>
<% end %>
