<%= turbo_frame_tag "documents" do %>
  <table class="table table-sm table-borderless mb-0 align-middle">
    <% @documents.each do |document| %>
      <%= tag.tr do %>
        <td>
          <%= link_to document.title, url_for(document.file), target: "_blank", rel: "noopener" %>
        </td>
      <% end %>
    <% end %>
  </table>

<nav aria-label="Page navigation">
  <ul class="pagination pagination-sm justify-content-center">
    <%# Previous button %>
    <% if @current_page > 1 %>
      <li class="page-item">
        <%= link_to "<", documents_path(page: @current_page - 1), data: { turbo_frame: "documents" }, class: "page-link" %>
      </li>
    <% else %>
      <li class="page-item disabled">
        <span class="page-link"><</span>
      </li>
    <% end %>

    <%# Define window size (how many pages around current) %>
    <% window_size = 0 %>
    <% first_page = 1 %>
    <% last_page = @total_pages %>

    <% left = [@current_page - window_size, first_page].max %>
    <% right = [@current_page + window_size, last_page].min %>

    <%# Show first page and ellipsis if needed %>
    <% if left > first_page %>
      <li class="page-item">
        <%= link_to first_page, documents_path(page: first_page), data: { turbo_frame: "documents" }, class: "page-link" %>
      </li>
      <% if left > first_page + 1 %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% end %>
    <% end %>

    <%# Show pages from left to right %>
    <% left.upto(right) do |page| %>
      <% active = (page == @current_page) ? 'active' : '' %>
      <li class="page-item <%= active %>">
        <% if page == @current_page %>
          <span class="page-link"><%= page %></span>
        <% else %>
          <%= link_to page, documents_path(page: page), data: { turbo_frame: "documents" }, class: "page-link" %>
        <% end %>
      </li>
    <% end %>

    <%# Show ellipsis and last page if needed %>
    <% if right < last_page %>
      <% if right < last_page - 1 %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% end %>
      <li class="page-item">
        <%= link_to last_page, documents_path(page: last_page), data: { turbo_frame: "documents" }, class: "page-link" %>
      </li>
    <% end %>

    <%# Next button %>
    <% if @current_page < last_page %>
      <li class="page-item">
        <%= link_to ">", documents_path(page: @current_page + 1), data: { turbo_frame: "documents" }, class: "page-link" %>
      </li>
    <% else %>
      <li class="page-item disabled">
        <span class="page-link">></span>
      </li>
    <% end %>
  </ul>
</nav>
<% end %>