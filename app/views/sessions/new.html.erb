<% content_for :head do %>
  <%= javascript_include_tag "login" %>
  <%= javascript_include_tag "auth_providers" %>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #f3f6fa;
      color: #2c3e50;
    }
    .topbar {
      background: #1f1f1f;
      display: flex;
      align-items: center;
      padding: 14px 32px;
      height: 64px;
    }
    .topbar .left { display: flex; align-items: center; gap: 24px; }
    .topbar img { height: 40px; }
    .topbar .links {
      display: flex; gap: 28px; margin-left: 32px;
    }
    .topbar .links a {
      color: #ccc; text-decoration: none; font-weight: 500;
    }
    .topbar .links a:hover { color: #fff; }

    .container {
      margin: 80px auto; display: flex;
      width: 880px; height: 520px;
      background: #fff; border-radius: 16px;
      box-shadow: 0 12px 48px rgba(0,0,0,0.08);
      overflow: hidden;
    }
    .form-section {
      flex: 3;
      padding: 0 40px 40px 40px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .form-section h2 {
      font-size: 26px; color: #1a237e; margin-bottom: 28px;
    }
    .form-group { margin-bottom: 18px; }
    .form-group label {
      display: block; font-size: 14px; margin-bottom: 6px;
    }
    .form-group input {
      width: 100%; padding: 12px;
      border: 1px solid #ccd6e0; border-radius: 8px;
    }
    .forgot-password {
      text-align: right; font-size: 12px; margin: 6px 0 20px;
    }
    .forgot-password a { color: #f57c00; text-decoration: none; }
    .sign-in-btn {
      width: 100%; padding: 12px;
      background: #1a237e; color: #fff;
      border: none; border-radius: 8px;
      font-weight: bold; font-size: 15px;
    }
    .signup-link {
      margin-top: 20px; text-align: center;
      font-size: 13px; color: #555;
    }
    .signup-link a {
      color: #f57c00; font-weight: bold;
      text-decoration: none;
    }

    .footer {
      margin: 80px auto; display: flex;
      width: 880px;
      background: #1f1f1f; color: #fff;
      padding: 32px;
      overflow: hidden;
    }
    .footer-content {
      max-width: 880px; margin: 0 auto;
    }
    .footer-content h2 {
      font-size: 18px; margin-bottom: 8px;
      color: #f57c00;
    }
    .footer-content h3 {
      font-size: 15px; margin-bottom: 20px;
      font-weight: 600;
    }
    .footer-body {
      # display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }
    .contact-list {
      list-style: none;
      padding: 0;
    }
    .contact-list li {
      display: flex;
      align-items: center;
      font-size: 14px;
      margin-bottom: 12px;
      color: #ccc;
    }
    .contact-list svg {
      width: 18px;
      height: 18px;
      margin-right: 10px;
      fill: white;
    }
    .contact-list a {
      color: #f57c00; text-decoration: none;
    }
    .contact-list a:hover { text-decoration: underline; }

    .footer-icons {
      display: flex; gap: 14px; margin-top: 4px;
    }
    .footer-icons svg {
      width: 30px; height: 30px;
      background: #fff; border-radius: 50%; padding: 4px;
    }

    @media (max-width: 768px) {
      .container { flex-direction: column; height: auto; }
      .footer { flex-direction: column; height: auto; }
      .image-section { height: 200px; }
      .footer-body { flex-direction: column; gap: 24px; }
    }
  </style>
<% end %>

<% content_for :heading_class, "pb-0" %>

<% if @preferred_auth_provider %>
  <%= render :partial => "auth_providers" %>
  <%= render :partial => "shared/section_divider", :locals => { :text => t(".or") } %>
<% end %>

<% if current_user %>
  <div class="alert alert-warning pb-0">
    <p>
      <%= t ".already_logged_in_html", :user => tag.strong(current_user.display_name) %>
    </p>
    <% if @safe_referer %>
      <p>
        <%= t ".access_another_page" %>
      </p>
      <p class="text-center">
        <%= link_to t(".visit_referring_page"), @safe_referer, :id => "referer_link", :class => "btn btn-warning" %>
      </p>
    <% end %>
  </div>
<% end %>

<div class="container">
  <div class="form-section">
    <div class="login-form-heading">
      <h2> <%= t(".login_header") %></h2>
      <%= image_tag "logoZvartnots.png", :class => "login_logo" %>
    </div>

    <%= bootstrap_form_tag(:action => "login", :html => { :id => "login_form" }) do |f| %>
      <%= hidden_field_tag("referer", h(params[:referer]), :autocomplete => "off") %>

      <%= f.text_field :username, :label => t(".email or username"), :autofocus => true, :tabindex => 1, :value => params[:username] %>

      <div class="d-flex flex-wrap column-gap-3 justify-content-between align-items-baseline mb-2">
        <%= f.label :password, t(".password") %>
        <small><%= link_to(t(".forgot password link"), user_forgot_password_path) %></small>
      </div>

      <%= f.password_field :password, :autocomplete => "on", :tabindex => 2, :value => "", :skip_label => true %>

      <%= f.form_group do %>
        <%= f.check_box :remember_me, { :label => t(".remember"), :tabindex => 3, :checked => (params[:remember_me] == "true") }, "yes" %>
      <% end %>

      <div class="mb-3">
        <%= f.primary t(".login_button"), :tabindex => 4, :class => "sign-in-btn" %>
      </div>
    <% end %>
  </div>
  <div class="new-user-form-image"></div>
</div>

<% unless @preferred_auth_provider or Auth.providers.empty? %>
  <%= render :partial => "shared/section_divider", :locals => { :text => t(".with external") } %>
  <%= render :partial => "auth_providers" %>
<% end %>

